# ---------- Telegram ----------
BOT_TOKEN=123456:AA...            # токен от @BotFather
BOT_USERNAME=targetvpn_bot        # username бота без @
WEBAPP_URL=https://vpn.example.com/app/    # адрес Mini App (тот же, что в BotFather)
SUPPORT_URL=https://t.me/ваш_аккаунт
OWNER_ID=7824168810               # владелец сервиса, полный доступ

# ---------- Инфраструктура (основной ВПС) ----------
# SQLite достаточно до нескольких тысяч пользователей.
DATABASE_URL=sqlite+aiosqlite:///./targetvpn.db
# DATABASE_URL=postgresql+asyncpg://targetvpn:пароль@127.0.0.1:5432/targetvpn
API_BASE_URL=http://127.0.0.1:8000        # бэкенд глазами бота
PUBLIC_BASE_URL=https://vpn.example.com   # публичный адрес (для ссылки-подписки)
INTERNAL_SECRET=смените-на-длинную-строку
JWT_SECRET=смените-на-другую-длинную-строку
CORS_ORIGINS=https://vpn.example.com

# ---------- VPN-нода (второй ВПС, Marzban + Xray Reality) ----------
MARZBAN_URL=https://node.example.com:8000
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=пароль_панели
MARZBAN_VERIFY_SSL=true
MARZBAN_INBOUNDS={"vless": ["VLESS TCP REALITY"]}
MARZBAN_PREFIX=tv
DEMO_MODE=false                   # true — работать без ноды, с фейковыми ключами

# ---------- Платежи ----------
CRYPTOBOT_TOKEN=                  # токен @CryptoBot -> Crypto Pay -> Create App
CRYPTOBOT_ASSET=USDT
RUB_PER_USDT=100                  # курс для пересчёта цены тарифа
RUB_PER_STAR=1.6                  # сколько рублей стоит одна звезда Telegram

# ---------- Прочее ----------
TRIAL_ENABLED=true
REFERRAL_BONUS_DAYS=7
